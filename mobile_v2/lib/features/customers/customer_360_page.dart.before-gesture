import 'package:flutter/material.dart';
import '../../main.dart' show CrmData, Customer;
import '../../core/theme/app_theme.dart';
import '../timeline/customer_timeline.dart';
import '../whatsapp/whatsapp_helper.dart';

class Customer360Page extends StatelessWidget {
  const Customer360Page({
    super.key,
    required this.data,
    required this.customer,
    this.onAddTask,
    this.onAddOpportunity,
  });

  final CrmData data;
  final Customer customer;
  final VoidCallback? onAddTask;
  final VoidCallback? onAddOpportunity;

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        backgroundColor: const Color(0xFFF8FAFC),
        appBar: AppBar(
          title: Text(customer.name),
          backgroundColor: AppTheme.primaryTeal,
          foregroundColor: Colors.white,
        ),
        body: ListView(
          padding: const EdgeInsets.all(14),
          children: [
            _headerCard(),
            const SizedBox(height: 14),
            _kpiRow(),
            const SizedBox(height: 20),
            _classificationSection(),
            const SizedBox(height: 20),
            _contactSection(),
            const SizedBox(height: 12),
            _quickActionsRow(context),
            const SizedBox(height: 20),
            _opportunitiesSection(),
            const SizedBox(height: 20),
            _tasksSection(),
            const SizedBox(height: 20),
            _timelineSection(),
            const SizedBox(height: 20),
            _notesSection(),
            const SizedBox(height: 80),
          ],
        ),
      ),
    );
  }

  // Header Card
  Widget _headerCard() {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: [AppTheme.primaryTeal, AppTheme.primaryTealLight],
          begin: Alignment.topRight,
          end: Alignment.bottomLeft,
        ),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Row(
        children: [
          Container(
            width: 64,
            height: 64,
            decoration: BoxDecoration(
              color: Colors.white.withAlpha(50),
              shape: BoxShape.circle,
            ),
            child: Center(
              child: Text(
                _initials(customer.name),
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
          const SizedBox(width: 14),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  customer.name,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  customer.company.isEmpty ? '—' : customer.company,
                  style: TextStyle(
                    color: Colors.white.withAlpha(220),
                    fontSize: 14,
                  ),
                ),
                const SizedBox(height: 6),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  decoration: BoxDecoration(
                    color: Colors.white.withAlpha(50),
                    borderRadius: BorderRadius.circular(20),
                  ),
                  child: Text(
                    customer.status,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 11,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  // KPI Row
  Widget _kpiRow() {
    final opps = data.opportunities.where((o) => o.customer == customer.name).toList();
    final tasks = data.tasks.where((t) => t.customer == customer.name).toList();
    final totalValue = opps.fold<double>(0, (s, o) => s + o.value);

    return Row(
      children: [
        Expanded(child: _kpi(icon: Icons.trending_up, label: 'فرص', value: '${opps.length}', color: AppTheme.cyan)),
        const SizedBox(width: 8),
        Expanded(child: _kpi(icon: Icons.receipt_long, label: 'قيمة', value: _money(totalValue), color: AppTheme.amber)),
        const SizedBox(width: 8),
        Expanded(child: _kpi(icon: Icons.check_circle, label: 'مهام', value: '${tasks.length}', color: AppTheme.success)),
      ],
    );
  }

  Widget _kpi({required IconData icon, required String label, required String value, required Color color}) {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 8),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: color.withAlpha(40), width: 1.5),
      ),
      child: Column(
        children: [
          Icon(icon, color: color, size: 22),
          const SizedBox(height: 6),
          Text(value, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: color)),
          const SizedBox(height: 2),
          Text(label, style: const TextStyle(fontSize: 11, color: Colors.black54)),
        ],
      ),
    );
  }

  // Contact Info

  // ═══════════════════════════════════════════════════════════
  // تصنيف العميل — القطاع، الحجم، الفرع، المندوب
  // ═══════════════════════════════════════════════════════════
  Widget _classificationSection() {
    final hasSector = customer.sector.isNotEmpty;
    final hasSize = customer.size.isNotEmpty;
    final hasBranch = customer.branch.isNotEmpty;
    final hasSalesRep = customer.salesRep.isNotEmpty;

    if (!hasSector && !hasSize && !hasBranch && !hasSalesRep) {
      return const SizedBox.shrink();
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _sectionTitle(
          icon: Icons.category_rounded,
          title: 'تصنيف العميل',
        ),
        const SizedBox(height: 8),
        Container(
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(16),
            border: Border.all(color: Colors.black.withAlpha(15)),
          ),
          child: Column(
            children: [
              if (hasSector) ...[
                _classRow(
                  icon: Icons.business_center_rounded,
                  label: 'القطاع',
                  value: customer.sector,
                  color: AppTheme.primaryTeal,
                ),
                const SizedBox(height: 8),
              ],
              if (hasSize) ...[
                _classRow(
                  icon: Icons.aspect_ratio_rounded,
                  label: 'الحجم',
                  value: customer.size,
                  color: AppTheme.cyan,
                ),
                const SizedBox(height: 8),
              ],
              if (hasBranch) ...[
                _classRow(
                  icon: Icons.store_rounded,
                  label: 'الفرع',
                  value: customer.branch,
                  color: AppTheme.amber,
                ),
                const SizedBox(height: 8),
              ],
              if (hasSalesRep)
                _classRow(
                  icon: Icons.person_pin_rounded,
                  label: 'المندوب',
                  value: customer.salesRep,
                  color: AppTheme.success,
                ),
            ],
          ),
        ),
      ],
    );
  }

  Widget _classRow({
    required IconData icon,
    required String label,
    required String value,
    required Color color,
  }) {
    return Row(
      children: [
        Container(
          padding: const EdgeInsets.all(8),
          decoration: BoxDecoration(
            color: color.withAlpha(30),
            borderRadius: BorderRadius.circular(10),
          ),
          child: Icon(icon, color: color, size: 18),
        ),
        const SizedBox(width: 12),
        Text(
          '$label: ',
          style: const TextStyle(
            fontSize: 13,
            color: Colors.black54,
            fontWeight: FontWeight.w500,
          ),
        ),
        Expanded(
          child: Text(
            value,
            style: const TextStyle(
              fontSize: 13,
              fontWeight: FontWeight.w600,
              color: Colors.black87,
            ),
          ),
        ),
      ],
    );
  }

  Widget _contactSection() {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: Colors.black.withAlpha(15)),
      ),
      child: Column(
        children: [
          if (customer.phone.isNotEmpty) _infoRow(Icons.phone, 'الهاتف', customer.phone),
          if (customer.email.isNotEmpty) _infoRow(Icons.email, 'البريد', customer.email),
          if (customer.assignedTo.isNotEmpty) _infoRow(Icons.person, 'المسؤول', customer.assignedTo),
          _infoRow(Icons.calendar_today, 'تاريخ الإضافة', _formatDate(customer.createdAt)),
        ],
      ),
    );
  }

  Widget _infoRow(IconData icon, String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        children: [
          Icon(icon, size: 18, color: AppTheme.primaryTeal),
          const SizedBox(width: 10),
          Text('$label: ', style: const TextStyle(fontSize: 12, color: Colors.black54)),
          Expanded(
            child: Text(value, style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 13)),
          ),
        ],
      ),
    );
  }

  // Opportunities
  // ═══════════════════════════════════════════════════════════
  // إجراءات سريعة — WhatsApp، اتصال
  // ═══════════════════════════════════════════════════════════
  Widget _quickActionsRow(BuildContext context) {
    return Row(
      children: [
        Expanded(
          child: _actionButton(
            icon: Icons.chat_rounded,
            label: 'واتساب',
            color: const Color(0xFF25D366),
            onTap: customer.phone.isEmpty
                ? null
                : () => WhatsAppHelper.openChat(context, customer.phone),
          ),
        ),
        const SizedBox(width: 10),
        Expanded(
          child: _actionButton(
            icon: Icons.phone_rounded,
            label: 'اتصال',
            color: AppTheme.primaryTeal,
            onTap: customer.phone.isEmpty
                ? null
                : () => WhatsAppHelper.call(context, customer.phone),
          ),
        ),
      ],
    );
  }

  Widget _actionButton({
    required IconData icon,
    required String label,
    required Color color,
    VoidCallback? onTap,
  }) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(14),
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 14),
        decoration: BoxDecoration(
          color: onTap == null ? Colors.grey.shade200 : color.withAlpha(20),
          borderRadius: BorderRadius.circular(14),
          border: Border.all(
            color: onTap == null ? Colors.grey.shade300 : color.withAlpha(80),
            width: 1.5,
          ),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              icon,
              color: onTap == null ? Colors.grey : color,
              size: 22,
            ),
            const SizedBox(width: 8),
            Text(
              label,
              style: TextStyle(
                color: onTap == null ? Colors.grey : color,
                fontWeight: FontWeight.bold,
                fontSize: 14,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _opportunitiesSection() {
    final opps = data.opportunities.where((o) => o.customer == customer.name).toList();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _sectionTitle(icon: Icons.trending_up, title: 'الفرص', count: opps.length),
        const SizedBox(height: 8),
        if (opps.isEmpty)
          _emptyBox('لا توجد فرص مسجلة')
        else
          ...opps.map((o) => _opportunityCard(o)),
      ],
    );
  }

  Widget _opportunityCard(dynamic o) {
    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AppTheme.cyan.withAlpha(50)),
      ),
      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: AppTheme.cyan.withAlpha(30),
              borderRadius: BorderRadius.circular(10),
            ),
            child: const Icon(Icons.trending_up, color: AppTheme.cyan, size: 18),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(o.title, style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 14)),
                const SizedBox(height: 2),
                Text(o.stage, style: const TextStyle(fontSize: 11, color: Colors.black54)),
              ],
            ),
          ),
          Text(
            _money(o.value),
            style: const TextStyle(fontWeight: FontWeight.bold, color: AppTheme.cyan, fontSize: 14),
          ),
        ],
      ),
    );
  }

  // Tasks
  Widget _tasksSection() {
    final tasks = data.tasks.where((t) => t.customer == customer.name).toList();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _sectionTitle(icon: Icons.check_circle, title: 'المهام', count: tasks.length),
        const SizedBox(height: 8),
        if (tasks.isEmpty)
          _emptyBox('لا توجد مهام')
        else
          ...tasks.map((t) => _taskCard(t)),
      ],
    );
  }

  Widget _taskCard(dynamic t) {
    return Container(
      margin: const EdgeInsets.only(bottom: 6),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.black.withAlpha(15)),
      ),
      child: Row(
        children: [
          Icon(
            t.done ? Icons.check_circle : Icons.circle_outlined,
            color: t.done ? AppTheme.success : AppTheme.primaryTeal,
            size: 20,
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Text(
              t.title,
              style: TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w500,
                decoration: t.done ? TextDecoration.lineThrough : null,
                color: t.done ? Colors.black45 : Colors.black87,
              ),
            ),
          ),
        ],
      ),
    );
  }

  // Notes
  // ═══════════════════════════════════════════════════════════
  // Timeline — السجل الزمني للعميل
  // ═══════════════════════════════════════════════════════════
  Widget _timelineSection() {
    final events = <TimelineEvent>[];

    // 1. إنشاء العميل
    events.add(TimelineEvent(
      icon: Icons.person_add_rounded,
      title: 'إضافة العميل',
      description: customer.company,
      date: customer.createdAt,
      color: AppTheme.primaryTeal,
      type: 'إنشاء',
    ));

    // 2. الفرص
    for (final o in data.opportunities.where((o) => o.customer == customer.name)) {
      events.add(TimelineEvent(
        icon: Icons.trending_up_rounded,
        title: o.title,
        description: 'القيمة: ${_money(o.value)} • الحالة: ${o.stage}',
        date: o.createdAt,
        color: AppTheme.cyan,
        type: 'فرصة',
      ));
    }

    // 3. المهام
    for (final t in data.tasks.where((t) => t.customer == customer.name)) {
      events.add(TimelineEvent(
        icon: t.done ? Icons.task_alt_rounded : Icons.task_outlined,
        title: t.title,
        description: t.done ? 'مكتملة' : 'قيد التنفيذ',
        date: t.createdAt,
        color: t.done ? AppTheme.success : AppTheme.amber,
        type: 'مهمة',
      ));
    }

    return CustomerTimeline(events: events);
  }

  Widget _notesSection() {
    if (customer.notes.isEmpty) return const SizedBox.shrink();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _sectionTitle(icon: Icons.notes, title: 'ملاحظات'),
        const SizedBox(height: 8),
        Container(
          width: double.infinity,
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(12),
            border: Border.all(color: Colors.black.withAlpha(15)),
          ),
          child: Text(customer.notes, style: const TextStyle(fontSize: 13, height: 1.5)),
        ),
      ],
    );
  }

  // Helpers
  Widget _sectionTitle({required IconData icon, required String title, int? count}) {
    return Row(
      children: [
        Icon(icon, color: AppTheme.primaryTeal, size: 20),
        const SizedBox(width: 8),
        Text(title, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
        if (count != null) ...[
          const SizedBox(width: 8),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
            decoration: BoxDecoration(
              color: AppTheme.primaryTeal,
              borderRadius: BorderRadius.circular(10),
            ),
            child: Text(
              '$count',
              style: const TextStyle(color: Colors.white, fontSize: 11, fontWeight: FontWeight.bold),
            ),
          ),
        ],
      ],
    );
  }

  Widget _emptyBox(String text) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.symmetric(vertical: 20),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.black.withAlpha(15)),
      ),
      child: Center(
        child: Text(text, style: const TextStyle(color: Colors.black38, fontSize: 13)),
      ),
    );
  }

  String _initials(String name) {
    final parts = name.trim().split(' ');
    if (parts.isEmpty) return '؟';
    if (parts.length == 1) return parts[0].substring(0, 1);
    return parts[0].substring(0, 1) + parts[1].substring(0, 1);
  }

  String _money(double value) {
    if (value >= 1000000) return '${(value / 1000000).toStringAsFixed(1)}M';
    if (value >= 1000) return '${(value / 1000).toStringAsFixed(1)}K';
    return value.toStringAsFixed(0);
  }

  String _formatDate(DateTime d) {
    return '${d.year}/${d.month.toString().padLeft(2, '0')}/${d.day.toString().padLeft(2, '0')}';
  }
}
