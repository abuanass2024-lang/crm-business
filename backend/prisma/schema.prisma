generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

enum UserRole {
OWNER
ADMIN
MANAGER
SALES
VIEWER
GENERAL_MANAGER
REGIONAL_MANAGER
BRANCH_MANAGER
HALL_MANAGER
CUSTOMER_SERVICE
}

enum CompanyStatus {
ACTIVE
SUSPENDED
}

enum OpportunityStage {
LEAD
QUALIFIED
MEETING
PROPOSAL
NEGOTIATION
WON
LOST
}

enum TaskStatus {
TODO
IN_PROGRESS
COMPLETED
CANCELLED
}

enum TaskPriority {
LOW
MEDIUM
HIGH
URGENT
}

model Company {
id                       String                   @id @default(cuid())
name                     String
country                  String?                  @default("YE")
currency                 String?                  @default("YER")
status                   CompanyStatus            @default(ACTIVE)
createdAt                DateTime                 @default(now())
updatedAt                DateTime                 @updatedAt
users                    User[]
customers                Customer[]
opportunities            Opportunity[]
opportunityStageHistory  OpportunityStageHistory[]
tasks                    Task[]
activities               Activity[]
notifications            Notification[]
auditLogs                AuditLog[]
automationRules          AutomationRule[]
automationExecutions     AutomationExecution[]
subscriptions            Subscription[]
sessions                 UserSession[]
platformAdmins           PlatformAdmin[]
}

model User {
id             String          @id @default(cuid())
companyId      String
employeeId     String?
branch         String?
name           String
email          String
passwordHash   String
role           UserRole        @default(SALES)
active         Boolean         @default(true)
createdAt      DateTime        @default(now())
company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
tasks          Task[]          @relation("TaskAssignee")
activities     Activity[]
notifications  Notification[]
sessions       UserSession[]
platformAdmin  PlatformAdmin?
taskComments   TaskComment[]
@@unique([companyId, email])
@@unique([companyId, employeeId])
@@index([companyId])
@@index([employeeId])
@@index([branch])
}

enum CustomerStatus {
PROSPECT
CUSTOMER
ACTIVE
INACTIVE
WITHDRAWN
}

model Customer {
id             String         @id @default(cuid())
companyId      String
name           String
companyName    String?
phone          String?
email          String?
address        String?
status         CustomerStatus @default(PROSPECT)
assignedTo     String?
branch         String?
firstInteractionAt DateTime?
lastInteractionAt  DateTime?
createdAt      DateTime       @default(now())
updatedAt      DateTime       @updatedAt
company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
opportunities  Opportunity[]
tasks          Task[]
activities     Activity[]
@@index([companyId, createdAt])
@@index([branch])
}

model Opportunity {
id                String                   @id @default(cuid())
companyId         String
customerId        String
title             String
value             Decimal                  @db.Decimal(18, 2)
currency          String                   @default("YER")
stage             OpportunityStage         @default(LEAD)
probability       Int                      @default(10)
expectedCloseDate DateTime?
assignedTo        String?
createdAt         DateTime                 @default(now())
updatedAt         DateTime                 @updatedAt
company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
customer          Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
stageHistory      OpportunityStageHistory[]
tasks             Task[]
activities        Activity[]
@@index([companyId, stage])
}

model OpportunityStageHistory {
id             String            @id @default(cuid())
companyId      String
opportunityId  String
fromStage      OpportunityStage?
toStage        OpportunityStage
changedBy      String?
createdAt      DateTime          @default(now())
company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
@@index([companyId, opportunityId, createdAt])
}

model Task {
id             String        @id @default(cuid())
companyId      String
title          String
description    String?
customerId     String?
opportunityId  String?
assignedTo     String?
dueDate        DateTime?
status         TaskStatus    @default(TODO)
priority       TaskPriority  @default(MEDIUM)
createdAt      DateTime      @default(now())
updatedAt      DateTime      @updatedAt
company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
assignee       User?         @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
comments       TaskComment[]
@@index([companyId, status])
@@index([companyId, dueDate])
}

model TaskComment {
id        String   @id @default(cuid())
taskId    String
userId    String
message   String   @db.Text
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
@@index([taskId, createdAt])
@@index([userId])
}

model Activity {
id             String       @id @default(cuid())
companyId      String
userId         String
customerId     String?
opportunityId  String?
type           String
description    String
createdAt      DateTime     @default(now())
company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
@@index([companyId, createdAt])
}

model Notification {
id             String       @id @default(cuid())
companyId      String
userId         String
type           String
title          String
message        String
referenceType  String?
referenceId    String?
isRead         Boolean      @default(false)
createdAt      DateTime     @default(now())
company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
@@index([companyId, userId, isRead, createdAt])
}

model AuditLog {
id          String    @id @default(cuid())
companyId   String
userId      String?
action      String
entity      String
entityId    String?
metadata    Json?
createdAt   DateTime  @default(now())
company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
@@index([companyId, createdAt])
@@index([companyId, entity, entityId])
}

enum AutomationTrigger {
CUSTOMER_CREATED
OPPORTUNITY_CREATED
OPPORTUNITY_STAGE_CHANGED
TASK_CREATED
TASK_DUE_SOON
TASK_OVERDUE
OPPORTUNITY_WON
OPPORTUNITY_LOST
}

enum AutomationAction {
CREATE_TASK
CREATE_NOTIFICATION
CHANGE_CUSTOMER_STATUS
LOG_ACTIVITY
}

model AutomationRule {
id           String             @id @default(cuid())
companyId    String
name         String
description  String?
enabled      Boolean            @default(true)
trigger      AutomationTrigger
condition    Json?
action       AutomationAction
actionData   Json?
createdBy    String?
createdAt    DateTime           @default(now())
updatedAt    DateTime           @updatedAt
company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
executions   AutomationExecution[]
@@index([companyId, enabled, trigger])
}

model AutomationExecution {
id             String             @id @default(cuid())
companyId      String
ruleId         String
executionKey   String
trigger        AutomationTrigger
status         String             @default("SUCCESS")
context        Json?
result         Json?
error          String?
createdAt      DateTime           @default(now())
company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
rule           AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
@@unique([ruleId, executionKey])
@@index([companyId, createdAt])
}

enum SubscriptionStatus {
TRIAL
ACTIVE
PAST_DUE
SUSPENDED
CANCELLED
}

model Plan {
id              String         @id @default(cuid())
code            String         @unique
name            String
description     String?
monthlyPrice    Decimal        @db.Decimal(18, 2) @default(0)
annualPrice     Decimal        @db.Decimal(18, 2) @default(0)
maxUsers        Int            @default(5)
maxCustomers    Int            @default(1000)
maxOpportunities Int           @default(1000)
active          Boolean        @default(true)
sortOrder       Int            @default(0)
createdAt       DateTime       @default(now())
updatedAt       DateTime       @updatedAt
subscriptions   Subscription[]
}

model Subscription {
id          String             @id @default(cuid())
companyId   String
planId      String
status      SubscriptionStatus @default(TRIAL)
startDate   DateTime           @default(now())
endDate     DateTime?
trialEnd    DateTime?
createdAt   DateTime           @default(now())
updatedAt   DateTime           @updatedAt
company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
@@index([companyId, status])
@@index([planId])
}

model RolePermission {
id          String    @id @default(cuid())
role        UserRole
permission  String
createdAt   DateTime  @default(now())
@@unique([role, permission])
@@index([role])
}

model UserSession {
id               String    @id @default(cuid())
userId           String
companyId        String
refreshTokenHash String    @unique
expiresAt        DateTime
revokedAt        DateTime?
createdAt        DateTime  @default(now())
user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
@@index([companyId, userId])
@@index([expiresAt])
}

model PlatformAdmin {
id         String   @id @default(cuid())
userId     String
companyId  String
active     Boolean  @default(true)
createdAt  DateTime @default(now())
user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
@@unique([userId])
@@index([companyId, active])
}